{
  "name": "obsidian-just-vertical-tabs-resize",
  "version": "1.0.0",
  "description": "Drag-to-resize companion for the Just Vertical Tabs community plugin.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "caichen2333",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caichen2333/obsidian-just-vertical-tabs-resize.git"
  },
  "engines": {
    "node": ">=22.20"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run build && npm test",
    "package": "npm run check && node scripts/package.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "overrides": {
    "eslint-plugin-n": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "jsdom": "^27.4.0",
    "obsidian": "latest",
    "typescript": "^5.8.3"
  }
}
